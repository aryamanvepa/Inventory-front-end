{
  "name": "torte-living-os",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Torte Living Business Operating System - pilot (inventory & packing PWA on Supabase)",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test:db": "node tests/acceptance.test.mjs",
    "test:webhook": "node --experimental-strip-types tests/webhook-mapper.test.mjs",
    "test:storefront": "node --experimental-strip-types tests/storefront.test.mjs",
    "test": "npm run test:db && npm run test:webhook && npm run test:storefront && npm run test:finance && npm run test:upgrade && npm run test:inventory && npm run test:catalogue && npm run test:notify && npm run test:settings && npm run test:inspector && npm run test:storefront2 && npm run test:overrides && npm run test:status",
    "test:finance": "node tests/finance.test.mjs",
    "test:upgrade": "node tests/upgrade-path.test.mjs",
    "test:inventory": "node tests/inventory.test.mjs",
    "test:catalogue": "node tests/catalogue.test.mjs",
    "test:notify": "node tests/notify.test.mjs",
    "test:settings": "node tests/settings.test.mjs",
    "test:inspector": "node tests/inspector.test.mjs",
    "test:storefront2": "node --experimental-strip-types tests/storefront-backend.test.mjs",
    "test:overrides": "node tests/test-overrides.test.mjs",
    "test:status": "node --experimental-strip-types tests/catalogue-status.test.mjs"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.16",
    "@supabase/supabase-js": "^2.119.0",
    "barcode-detector": "^3.2.3",
    "jsbarcode": "^3.11.6",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zxing-wasm": "^3.1.6"
  },
  "devDependencies": {
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "typescript": "^5.9.3",
    "vite": "^5.4.21"
  }
}
